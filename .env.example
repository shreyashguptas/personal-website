# OpenRouter API Key — the single key for the whole chat path.
# Serves BOTH the chat completions (DeepSeek V4 Flash, with failover) and the
# query/build embeddings (Qwen3-Embedding-8B on DeepInfra).
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional OpenRouter overrides. Defaults live in src/lib/prompts.ts; set these
# only to route around a bad model or a provider outage without a redeploy.
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# Comma-separated failover chain. A BLANK value disables failover entirely.
# OPENROUTER_FALLBACK_MODELS=deepseek/deepseek-v4-flash,amazon/nova-lite-v1
# Comma-separated provider allowlist. Every slug must also be permitted by the
# OpenRouter account's own allowed-providers setting, or every request 404s.
# OPENROUTER_PROVIDERS=deepinfra,amazon-bedrock

# Upstash Redis (for rate limiting in production)
# Optional - falls back to in-memory rate limiting in development
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
